{
  "format": "pocket-mods.theme",
  "version": 1,
  "id": "ember",
  "name": "Ember",
  "release": "1.0.0",
  "author": "Pocket Mods",
  "description": "Warm charcoal, amber keys and an amber display, easy on the eyes.",
  "scheme": "dark",
  "tokens": {
    "--bg": "#171412",
    "--bg2": "#26221e",
    "--surface": "#211d19",
    "--surface-2": "#2c2722",
    "--line": "#3f3830",
    "--text": "#f7ecdf",
    "--text-2": "#dac9b6",
    "--text-3": "#aa9880",
    "--accent": "#ffab2e",
    "--on-accent": "#1d1204",
    "--chrome-bg": "#0d0b09",
    "--chrome-fg": "#f2e6d6",
    "--disp-bg": "#d9a441",
    "--disp-fg": "#2a1700",
    "--disp-hot": "#f3e07a",
    "--disp-bad": "#f07f62",
    "--ok": "#8fcf6b",
    "--warn": "#ffc861",
    "--bad": "#ff7759",
    "--acc2": "#7db6ff",
    "--on-bad": "#1d1204",
    "--hl": "rgba(255, 255, 255, .05)",
    "--card-shadow": "0 0 0 1px var(--line), 0 2px 0 rgba(0, 0, 0, .55), 0 10px 24px rgba(0, 0, 0, .35)",
    "--drop": "0 24px 60px rgba(0, 0, 0, .6), 0 0 0 1px var(--line)",
    "--scrim": "rgba(0, 0, 0, .5)"
  }
}
