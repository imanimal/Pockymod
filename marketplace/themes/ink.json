{
  "format": "pocket-mods.theme",
  "version": 1,
  "id": "ink",
  "name": "Ink",
  "release": "1.0.0",
  "author": "Pockymod",
  "description": "Black on white with red keys. High contrast.",
  "scheme": "light",
  "tokens": {
    "--bg": "#f0f0ee",
    "--bg2": "#ffffff",
    "--surface": "#ffffff",
    "--surface-2": "#ebebe8",
    "--line": "#b3b3ae",
    "--text": "#000000",
    "--text-2": "#1e1e1e",
    "--text-3": "#4a4a4a",
    "--accent": "#d7261e",
    "--on-accent": "#ffffff",
    "--chrome-bg": "#000000",
    "--chrome-fg": "#ffffff",
    "--disp-bg": "#d6dacb",
    "--disp-fg": "#0b0d06",
    "--disp-hot": "#f2c14e",
    "--disp-bad": "#f08a74",
    "--ok": "#1b6e20",
    "--warn": "#8a4b00",
    "--bad": "#b3170c",
    "--acc2": "#0b4fc4",
    "--on-bad": "#ffffff",
    "--hl": "rgba(255, 255, 255, .6)",
    "--card-shadow": "0 0 0 1px var(--line), 0 2px 0 var(--line)",
    "--drop": "0 20px 50px rgba(0, 0, 0, .25), 0 0 0 1px #000",
    "--scrim": "rgba(0, 0, 0, .4)"
  }
}
