{
  "format": "pocket-mods.theme",
  "version": 1,
  "id": "neon-harbor",
  "name": "Neon Harbor",
  "author": "Pockymod examples",
  "description": "Navy with a pink accent and teal selection. Dark or light.",
  "scheme": "dark",
  "base": "standard",
  "tokens": {
    "--radius": "10px",
    "--btn-r": "8px"
  },
  "dark": {
    "--bg": "#090d1a",
    "--bg2": "#060914",
    "--surface": "#0f1526",
    "--surface-2": "#172036",
    "--line": "#26304a",
    "--text": "#eef1fb",
    "--text-2": "#bcc4dc",
    "--text-3": "#8b95b3",
    "--accent": "#ff4fa3",
    "--on-accent": "#12030b",
    "--acc2": "#3fe0c5",
    "--chrome-bg": "#050812",
    "--chrome-fg": "#c9d1ea",
    "--disp-bg": "#051416",
    "--disp-fg": "#3fe0c5",
    "--disp-hot": "#ffc857",
    "--disp-bad": "#ff6b81",
    "--ok": "#45d483",
    "--warn": "#ffc857",
    "--bad": "#ff6b81"
  },
  "light": {
    "--bg": "#eef0f8",
    "--bg2": "#ffffff",
    "--surface": "#ffffff",
    "--surface-2": "#eff1f8",
    "--line": "#d3d8e8",
    "--text": "#10142a",
    "--text-2": "#353c58",
    "--text-3": "#5a6283",
    "--accent": "#e0267f",
    "--on-accent": "#ffffff",
    "--accent-ink": "#b8145f",
    "--acc2": "#007a69",
    "--chrome-bg": "#141a30",
    "--chrome-fg": "#e3e7f5",
    "--disp-bg": "#0d1a26",
    "--disp-fg": "#3fe0c5",
    "--disp-hot": "#ffc857",
    "--disp-bad": "#ff8a9b",
    "--ok": "#1b8a50",
    "--warn": "#9a6100",
    "--bad": "#c8243e"
  },
  "css": ".nv.on { box-shadow: 0 0 0 1px var(--line); }\n.panel.hot > .ph .pt { letter-spacing: .14em; }\n:root[data-scheme=\"light\"] .shell > .mtop { box-shadow: inset 0 -2px 0 var(--accent); }\n"
}
